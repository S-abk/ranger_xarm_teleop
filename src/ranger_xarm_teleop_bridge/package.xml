<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_xarm_teleop_bridge</name>
  <version>0.1.0</version>
  <description>Bridge from the vr-teleop-kit WebSocket relay (Meta Quest 3, WebXR) to the /teleop/input/* topics, with JSONL recording, replay and analysis.</description>
  <maintainer email="solanrewaju2020@fau.edu">Shuaib Olanrewaju</maintainer>
  <license>Apache-2.0</license>

  <depend>ranger_xarm_teleop_interfaces</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>python3-websockets</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-numpy</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
