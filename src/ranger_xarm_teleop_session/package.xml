<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_xarm_teleop_session</name>
  <version>0.1.0</version>
  <description>One command to start a teleoperation session for a deployment profile (the manual sequence's own launch files, in order), check that everything needed is in place, and stop it cleanly.</description>
  <maintainer email="solanrewaju2020@fau.edu">Shuaib Olanrewaju</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ranger_xarm_teleop_interfaces</exec_depend>
  <exec_depend>ranger_xarm_teleop_record</exec_depend>
  <exec_depend>ranger_xarm_teleop_bringup</exec_depend>
  <exec_depend>ranger_xarm_teleop_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
