<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_xarm_teleop_record</name>
  <version>0.1.0</version>
  <description>Demonstration episodes: episode control from the left controller, a rosbag2 recorder with one file per episode, a self-describing sidecar, a checker and a fixed-rate export.</description>
  <maintainer email="solanrewaju2020@fau.edu">Shuaib Olanrewaju</maintainer>
  <license>Apache-2.0</license>

  <depend>ranger_xarm_teleop_interfaces</depend>
  <depend>ranger_xarm_teleop_bridge</depend>
  <depend>ranger_xarm_teleop_servo</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>control_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rosbag2_interfaces</depend>
  <depend>rosbag2_py</depend>
  <depend>rosbag2_storage_mcap</depend>
  <depend>rosbag2_compression_zstd</depend>
  <depend>ros2bag</depend>
  <depend>ament_index_python</depend>
  <depend>python3-numpy</depend>
  <depend>python3-yaml</depend>
  <depend>python3-pil</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
