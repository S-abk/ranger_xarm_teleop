<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ranger_xarm_teleop_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration for teleoperating the arm through MoveIt Servo: mock execution and simulator paths, the teleop trajectory controller and the simulation-only limit values.</description>
  <maintainer email="solanrewaju2020@fau.edu">Shuaib Olanrewaju</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ranger_xarm_teleop_servo</exec_depend>
  <exec_depend>ranger_xarm_teleop_bridge</exec_depend>
  <exec_depend>ranger_xarm_moveit_config</exec_depend>
  <exec_depend>ranger_xarm_description</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
