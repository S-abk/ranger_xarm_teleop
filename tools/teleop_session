"""
Start, check and stop a teleoperation session with one command (README, "Start a session").

    tools/teleop_session start --profile gazebo     # or mock; Ctrl-C stops it
    tools/teleop_session start --role relay         # operator PC: the relay only, no ROS
    tools/teleop_session stop
    tools/teleop_session status

The stack role needs ROS sourced (the robot workspace and this checkout's install); the relay
role needs only Python 3 and the relay's .venv (tools/relay_setup.sh).
"""

import os
import sys

CHECKOUT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(CHECKOUT, 'src', 'ranger_xarm_teleop_session'))

from ranger_xarm_teleop_session.cli import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main(checkout=CHECKOUT))
